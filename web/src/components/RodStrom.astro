---
// Svislý rodokmen celého rodu (data/rod_<jméno>.json → „rodokmen“): vnořené seznamy, vše rozbalené.
// Uzel: { jmeno, roky?, pozn?, manzel?, stav (doc|lit|prob|hyp), vazba? (typ čáry k rodiči: doc|lit|prob|hyp|nejiste), popis? (popisek vztahu),
//         nase? (přímá linie), osoba? (slug), profil? (id profilu), deti?: [uzly] }
import { people } from '../lib/data.js';
interface Props { uzly: any[]; slug: string; profily?: Record<string, any>; koren?: boolean }
const { uzly, slug, profily = {}, koren = false } = Astro.props;
const odkaz = (u) => (u.osoba && people[u.osoba] ? `/osoba/${u.osoba}/` : u.profil && profily[u.profil] ? `/${slug}/${u.profil}/` : null);
---
<ul class={koren ? 'rs rs-koren' : 'rs'}>
  {uzly.map((u) => {
    const href = odkaz(u);
    return (
      <li class={`rs-v-${u.vazba ?? u.stav ?? 'lit'}`}>
        <div class={`rs-uzel rs-st-${u.stav ?? 'lit'}${u.nase ? ' rs-nase' : ''}`}>
          {u.popis && <span class="rs-popis">{u.popis}</span>}
          <span class="rs-jmeno">{href ? <a href={href}>{u.jmeno}</a> : u.jmeno}</span>
          {u.roky && <span class="rs-roky">{u.roky}</span>}
          {u.manzel && <span class="rs-manzel">{u.manzel}</span>}
          {u.pozn && <span class="rs-pozn">{u.pozn}</span>}
        </div>
        {u.deti?.length > 0 && <Astro.self uzly={u.deti} slug={slug} profily={profily} />}
      </li>
    );
  })}
</ul>

<style>
  .rs { list-style: none; margin: 0; padding: 0 0 0 1.5rem; }
  .rs-koren { padding-left: 0; }
  .rs li { position: relative; padding: 0.3rem 0 0.3rem 1rem; }
  .rs-koren > li { padding-left: 0; }
  /* svislá čára od rodiče a vodorovná k uzlu */
  .rs:not(.rs-koren) > li::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; border-left: 2px solid var(--rs-c); }
  .rs:not(.rs-koren) > li:last-child::before { bottom: auto; height: 1.35rem; }
  .rs:not(.rs-koren) > li::after { content: ''; position: absolute; left: 0; top: 1.35rem; width: 0.9rem; border-top: 2px solid var(--rs-c); }
  .rs li { --rs-c: #8a5a2b; }
  .rs li.rs-v-doc { --rs-c: #3f7d4a; }
  .rs li.rs-v-prob { --rs-c: #b07a1e; }
  .rs li.rs-v-hyp::before, .rs li.rs-v-hyp::after { border-style: dashed !important; }
  .rs li.rs-v-hyp { --rs-c: #b07a1e; }
  .rs li.rs-v-nejiste::before, .rs li.rs-v-nejiste::after { border-style: dotted !important; }
  .rs li.rs-v-nejiste { --rs-c: #8a8278; }
  .rs-uzel { display: inline-flex; flex-direction: column; gap: 0.05rem; max-width: 30rem; padding: 0.35rem 0.65rem; border: 1.6px solid #8a5a2b; border-radius: 8px; background: #fffdf8; font-size: 0.9rem; line-height: 1.3; }
  .rs-st-doc { border-color: #3f7d4a; background: #eef6ee; }
  .rs-st-fam { border-color: #3f7d4a; background: #f6faf5; }
  .rs-st-prob { border-color: #b07a1e; background: #fbf1db; }
  .rs-st-hyp { border-color: #8a8278; border-style: dashed; background: #f2efe9; }
  .rs-nase { box-shadow: 0 0 0 3px #3f7d4a33; border-width: 2.4px; }
  .rs-jmeno { font: 600 0.98rem var(--serif); }
  .rs-roky { color: #5a4632; font-size: 0.85rem; }
  .rs-manzel { color: #5a4632; font-size: 0.85rem; }
  .rs-pozn { color: #6e6153; font-size: 0.8rem; }
  .rs-popis { font-style: italic; color: #8a8278; font-size: 0.75rem; }
  @media (max-width: 720px) {
    .rs { padding-left: 0.55rem; }
    .rs li { padding-left: 0.75rem; }
    .rs:not(.rs-koren) > li::after { width: 0.65rem; }
    .rs-uzel { font-size: 0.82rem; padding: 0.3rem 0.5rem; }
  }
</style>
