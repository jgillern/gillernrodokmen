---
import Base from '../layouts/Base.astro';
import { stats, lines, href, config, linesTitle } from '../lib/data.js';
import fan from '../generated/fan.svg?raw';
import FamilyMap from '../components/FamilyMap.astro';
import site from '../data/site.json';
import { frontmatter as pribeh } from '../generated/pribeh.md';
const lineList = Object.values(lines).sort((a, b) => a.k - b.k);
const uvod = config.uvod ?? {};
const cards = config.zajimavosti_na_uvodu ?? [];
const osa = config.casova_osa ?? [];
---
<Base title="" wide>
  <h1>{config.nazev || 'Rodokmen'}</h1>
  {config.podtitul && <p class="lead">{config.podtitul} {osa.length > 0 && <a href="#cesta-casem">Projít cestu časem ↓</a>}</p>}

  {!!(uvod.nadpis || uvod.odstavce?.length) && (
    <section class="teaser">
      <div>
        {uvod.nadpis && <h2>{uvod.nadpis}</h2>}
        {(uvod.odstavce ?? []).map((t) => <p>{t}</p>)}
        {config.maPribeh && <a class="btn" href="/pribehy/">{config.pribeh?.tlacitko || `Přečíst: ${pribeh.title}`} →</a>}
      </div>
      {uvod.foto && (
        <a href={config.maPribeh ? '/pribehy/' : `/img/${uvod.foto}.jpg`}><img src={`/img/${uvod.foto}.jpg`} alt={uvod.foto_popis || ''} /></a>
      )}
    </section>
  )}

  {config.maPribeh && !(uvod.nadpis || uvod.odstavce?.length) && (
    <section class="teaser">
      <div>
        <h2>{pribeh.title}</h2>
        {pribeh.lead && <p>{pribeh.lead}</p>}
        <a class="btn" href="/pribehy/">{config.pribeh?.tlacitko || 'Přečíst příběh'} →</a>
      </div>
    </section>
  )}

  <div class="stats">
    <div><strong>{stats.ancestors}</strong>známých předků</div>
    <div><strong>{stats.documented}</strong>doloženo matrikou</div>
    <div><strong>{stats.generations}</strong>generací</div>
    <div><strong>{stats.records}</strong>matričních zápisů</div>
  </div>

  {cards.length > 0 && (
    <>
      <h2>Zajímavosti</h2>
      <div class="grid2">
        {cards.map((c) => (
          <a class="card card-link" href="/zajimavosti/"><h3>{c.nadpis}</h3><p class="small muted">{c.text}</p></a>
        ))}
      </div>
      <p><a href="/zajimavosti/">Všechny zajímavosti →</a></p>
    </>
  )}

  {osa.length > 0 && (
    <section id="cesta-casem" class="osa">
      <h2>Cesta časem</h2>
      {osa.map((o) => (
        <div class="osa-obdobi">
          <h3>{o.obdobi} <span class="muted">({o.roky})</span></h3>
          {o.popis && <p class="small muted">{o.popis}</p>}
          <ol>
            {o.udalosti.map((u) => (
              <li class={u.historie ? 'hist' : ''}>
                <span class="rok">{u.rok}</span>
                <div>
                  {u.strana && <span class="tag">{u.strana}</span>}
                  {u.historie && <span class="tag">dobová souvislost</span>}
                  <strong>{u.osoba ? <a href={href.person(u.osoba)}>{u.nadpis}</a> : u.nadpis}</strong>
                  <p class="small">{u.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}
      {config.maPribeh && <p><a class="btn" href="/pribehy/">Příběhy rodů →</a></p>}
    </section>
  )}

  {site.places.length > 0 && (
    <>
      <h2>Kde žili naši předci</h2>
      <FamilyMap height="420px" compact />
      <p><a href="/mapa/">Celá mapa se jmény a filtrem rodů →</a></p>
    </>
  )}

  {lineList.length > 0 && (
    <>
      <h2>{linesTitle(lineList.length)}</h2>
      <div class="grid2">
        {lineList.map((l) => (
          <a class="card line-card card-link" style={`--c:${l.color}`} href={href.line(l.slug)}>
            <h3>{l.name}</h3>
            <p class="small muted">{l.desc}</p>
          </a>
        ))}
      </div>
    </>
  )}

  <h2>Rodokmen</h2>
  <div class="fan-preview"><a class="cover" href="/vejir/" aria-label="Otevřít vějíř předků přes celou obrazovku"></a><Fragment set:html={fan} /></div>
  <p><a class="btn" href="/rodokmen/">Celý rodokmen →</a> <a class="btn" href="/vejir/" style="margin-left:0.5rem">Vějíř přes celou obrazovku →</a> <a href="/predci/" style="margin-left:1rem">nebo seznam všech předků</a></p>
</Base>
