---
import Base from '../../layouts/Base.astro';
import { docs } from '../../lib/data.js';
import { kapitoly } from '../../lib/kapitoly.js';
import Filtry from '../../components/Filtry.astro';
import { OBDOBI } from '../../lib/data.js';
const stranaOf = (fm) => (/táto|otc/.test(fm.strana ?? '') ? 'otec' : /mám|matk/.test(fm.strana ?? '') ? 'matka' : 'otec matka');
const obdOf = (fm) => {
  const ys = (String(fm.obdobi ?? '').match(/\d{4}/g) || []).map(Number);
  if (!ys.length) return '';
  const a = /před/.test(String(fm.obdobi)) ? Math.min(...ys) - 30 : Math.min(...ys), b = Math.max(...ys);
  return OBDOBI.filter((o) => o.do >= a && o.od <= b).map((o) => o.id).join(' ');
};
const rodyOf = (fm) => (fm.rody?.length ? fm.rody.join(' ') : '8 9 10 11 12 13 14 15');
import { Content, frontmatter } from '../../generated/pribeh.md';
---
<Base title={frontmatter.title}>
  <p class="crumbs"><a href="/zajimavosti/">zajímavosti</a></p>
  <h1>{frontmatter.title}</h1>
  {frontmatter.lead && <p class="lead">{frontmatter.lead}</p>}

  {kapitoly.length > 0 && (
    <>
      <h2>Kapitoly</h2>
      <div data-filtr-scope>
      <Filtry />
      <div class="grid2">
        {kapitoly.map((k, i) => (
          <a class="card card-link" href={`/pribehy/${k.slug}/`} data-fi data-strana={stranaOf(k.fm)} data-rod={rodyOf(k.fm)} data-obdobi={obdOf(k.fm)}>
            <p class="small muted">{k.fm.strana ? `${k.fm.strana} · ` : ''}{k.fm.obdobi ?? ''}{k.fm.stav ? ' · rozpracováno' : ''}</p>
            <h3>{i + 1}. {k.fm.title}</h3>
            {k.fm.lead && <p class="small muted">{k.fm.lead}</p>}
          </a>
        ))}
      </div>
      </div>
    </>
  )}

  <div class="prose"><Content /></div>

  <div class="next-step">
    <p><strong>Chcete víc?</strong> Drobné objevy a kuriozity z matrik najdete v zajímavostech.</p>
    <a class="btn" href="/zajimavosti/">Zajímavosti z rodokmenu →</a>
  </div>

  {docs.length > 0 && (
    <>
      <h2>Rodinné dokumenty a fotografie</h2>
      <div class="docs">
        {docs.map((d) => (
          <figure><a href={`/img/${d.img}.jpg`} target="_blank" rel="noopener"><img src={`/img/${d.img}.jpg`} alt={d.caption} loading="lazy" /></a><figcaption>{d.caption}</figcaption></figure>
        ))}
      </div>
    </>
  )}
</Base>
