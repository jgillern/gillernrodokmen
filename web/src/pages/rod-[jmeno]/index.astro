---
// Stránka o celém rodu (data/rod_<jméno>.json → /rod-<jméno>/): erb, časová osa, větve, schéma napojení, další nositelé jména.
import Base from '../../layouts/Base.astro';
import RodStrom from '../../components/RodStrom.astro';
import stranky from '../../generated/rodove_stranky.json';
import { people } from '../../lib/data.js';

export function getStaticPaths() {
  return Object.keys(stranky).map((slug) => ({ params: { jmeno: slug.replace(/^rod-/, '') }, props: { slug } }));
}
const { slug } = Astro.props;
const d = stranky[slug];
const osobaHref = (s) => (s && people[s] ? `/osoba/${s}/` : null);
const profilHref = (id) => (id && d.profily?.[id] ? `/${slug}/${id}/` : null);

const STAV = {
  doc: { label: 'doloženo matrikou', cls: 'st-doc' },
  lit: { label: 'z literatury a tisku', cls: 'st-lit' },
  prob: { label: 'pravděpodobné', cls: 'st-prob' },
  hyp: { label: 'hypotéza / neověřeno', cls: 'st-unk' },
};

// schéma napojení – rozvržení do mřížky (sloupec s, řádek r)
const g = d.graf;
const W = 236, H = 66, CX = 300, RY = 92, X0 = 40, Y0 = 56;
const pos = Object.fromEntries((g?.uzly ?? []).map((u) => [u.id, { x: X0 + u.s * CX, y: Y0 + u.r * RY, u }]));
const rows = Math.max(0, ...(g?.uzly ?? []).map((u) => u.r)) + 1;
const svgW = X0 * 2 + (g?.sloupce?.length ?? 3) * CX - (CX - W);
const svgH = Y0 + rows * RY;
const edge = (h) => {
  const a = pos[h.z], b = pos[h.do];
  if (!a || !b) return null;
  if (a.u.r === b.u.r && Math.abs(a.u.s - b.u.s) > 1) {   // ob sloupec – obloukem nad uzlem mezi nimi
    const l = b.x > a.x, x1 = a.x + (l ? W : 0), x2 = b.x + (l ? 0 : W), y = a.y + 12;
    return { d: `M${x1},${y} C${x1 + (l ? 90 : -90)},${y - 52} ${x2 + (l ? -90 : 90)},${y - 52} ${x2},${y}`, lx: (x1 + x2) / 2, ly: y - 40 };
  }
  if (a.u.r === b.u.r) {
    const x1 = a.x + (b.x > a.x ? W : 0), x2 = b.x + (b.x > a.x ? 0 : W), y = a.y + H / 2;
    return { d: `M${x1},${y} L${x2},${y}`, lx: (x1 + x2) / 2, ly: y - 6 };
  }
  const skok = Math.abs(b.u.r - a.u.r) > 1;
  if (skok && a.u.s === b.u.s) {   // stejný sloupec přes víc řádků – obloukem po levé straně, ne přes uzly mezi nimi
    const x = a.x, y1 = a.y + H / 2, y2 = b.y + H / 2;
    return { d: `M${x},${y1} C${x - 34},${y1} ${x - 34},${y2} ${x},${y2}`, lx: x - 30, ly: (y1 + y2) / 2 };
  }
  if (skok) {   // jiný sloupec přes víc řádků – z boku vodorovně, pak shora do cíle
    const x1 = a.x + (b.x > a.x ? W : 0), y1 = a.y + H / 2, x2 = b.x + W / 2, y2 = b.y;
    return { d: `M${x1},${y1} C${x2},${y1} ${x2},${y1} ${x2},${y2}`, lx: (x1 + x2) / 2, ly: y1 - 6 };
  }
  const x1 = a.x + W / 2, y1 = a.y + H, x2 = b.x + W / 2, y2 = b.y;
  const my = (y1 + y2) / 2;
  return { d: `M${x1},${y1} C${x1},${my} ${x2},${my} ${x2},${y2}`, lx: (x1 + x2) / 2 + 4, ly: my - 2 };
};
const ESTYL = {
  doc: 'stroke:#3f7d4a;stroke-width:2.2',
  lit: 'stroke:#8a5a2b;stroke-width:1.8',
  hyp: 'stroke:#b07a1e;stroke-width:1.8;stroke-dasharray:7 5',
  nejiste: 'stroke:#8a8278;stroke-width:1.5;stroke-dasharray:2 5',
  svedek: 'stroke:#3e6488;stroke-width:1.8;stroke-dasharray:5 4',
};
const NSTYL = {
  doc: 'fill:#eef6ee;stroke:#3f7d4a',
  lit: 'fill:#fffdf8;stroke:#8a5a2b',
  prob: 'fill:#fbf1db;stroke:#b07a1e',
  hyp: 'fill:#f2efe9;stroke:#8a8278;stroke-dasharray:4 3',
};
// zjednodušená lilie (heraldická), kolem bodu 0,0, výška ~16
const LILIE = 'M0,-8 C3,-4 3,0 0,3 C-3,0 -3,-4 0,-8 Z M-1,1 C-6,-3 -9,1 -6,4 C-4,5 -2,3 -1,2 Z M1,1 C6,-3 9,1 6,4 C4,5 2,3 1,2 Z M-4.5,3 h9 v1.8 h-9 Z M-1.2,4.8 h2.4 L0,8.5 Z';
const HVEZDA = (cx, cy, r) => {
  const p = [];
  for (let i = 0; i < 10; i++) {
    const rr = i % 2 ? r * 0.42 : r, a = -Math.PI / 2 + (i * Math.PI) / 5;
    p.push(`${(cx + rr * Math.cos(a)).toFixed(1)},${(cy + rr * Math.sin(a)).toFixed(1)}`);
  }
  return p.join(' ');
};
---
<Base title={d.titul} wide>
  <div class="rg-hero">
    <div>
      <h1>{d.titul}</h1>
      <p class="lead">{d.lead}</p>
      {(d.uvod ?? []).map((t) => <p class="rg-uvod">{t}</p>)}
    </div>
    {d.erb && (
      <figure class="rg-erb">
        {d.erb.obrazek ? (
          <a href={d.erb.obrazek_velky ?? d.erb.obrazek} target="_blank" rel="noopener"><img class="rg-erb-img" src={d.erb.obrazek} alt="Erb svobodných pánů z Gillernů" width="600" height="802" /></a>
        ) : (
        <svg viewBox="0 0 200 244" role="img" aria-label="Erb svobodných pánů z Gillernů (zjednodušeně)">
          <defs>
            <clipPath id="stit"><path d="M10,10 H190 V122 Q190,202 100,236 Q10,202 10,122 Z" /></clipPath>
            <clipPath id="q2"><rect x="100" y="10" width="90" height="112" /></clipPath>
            <clipPath id="q3"><rect x="10" y="122" width="90" height="116" /></clipPath>
          </defs>
          <g clip-path="url(#stit)">
            <rect x="10" y="10" width="90" height="112" fill="#2f4f8f" />
            <rect x="100" y="10" width="90" height="112" fill="#a3262a" />
            <rect x="10" y="122" width="90" height="116" fill="#a3262a" />
            <rect x="100" y="122" width="90" height="116" fill="#2f4f8f" />
            <polygon points={HVEZDA(55, 64, 24)} fill="#e2b33c" />
            <polygon points={HVEZDA(145, 176, 24)} fill="#e2b33c" />
            {[['q2', 100, 10], ['q3', 10, 122]].map(([c, x, y]) => (
              <g clip-path={`url(#${c})`}>
                <polygon points={`${x + 90 - 13},${y} ${x + 90 + 13},${y} ${x + 13},${y + 116} ${x - 13},${y + 116}`} fill="#f4f1ea" />
                {[0.25, 0.5, 0.75].map((t) => (
                  <path d={LILIE} fill="#d9a62e" transform={`translate(${x + 90 - 90 * t},${y + 116 * t}) scale(1.05)`} />
                ))}
              </g>
            ))}
            <path d="M80,100 H120 V128 Q120,146 100,154 Q80,146 80,128 Z" fill="#e2b33c" stroke="#7a5a1c" stroke-width="1.2" />
            <circle cx="100" cy="129" r="8" fill="#c99a76" />
            <path d="M90,125 Q100,108 110,125 Q100,120 90,125 Z" fill="#f4f1ea" stroke="#9c8f7a" stroke-width="0.6" />
            <circle cx="100" cy="114" r="2.4" fill="#a3262a" />
          </g>
          <path d="M10,10 H190 V122 Q190,202 100,236 Q10,202 10,122 Z" fill="none" stroke="#3b2e22" stroke-width="3" />
        </svg>
        )}
        <figcaption class="small muted">{d.erb.popis}<br /><span class="rg-zdroj">{d.erb.zdroj}</span></figcaption>
      </figure>
    )}
  </div>

  <nav class="rg-toc small" aria-label="Obsah stránky">
    {g && <a href="#napojeni">Jak jsme napojeni</a>}
    {d.rodokmen && <a href="#rodokmen">Rodokmen rodu</a>}
    {d.osa?.length > 0 && <a href="#osa">Časová osa rodu</a>}
    {d.vetve?.length > 0 && <a href="#vetve">Větve rodu</a>}
    {d.osoby?.length > 0 && <a href="#osoby">Další Gillernové v pramenech</a>}
    {d.otazky?.length > 0 && <a href="#otazky">Co ještě hledáme</a>}
    {d.zdroje?.length > 0 && <a href="#zdroje">Zdroje</a>}
  </nav>

  {g && (
    <section id="napojeni">
      <h2>Jak jsme napojeni</h2>
      <p class="muted small">Zjednodušené schéma po generacích: uprostřed naše přímá linie od společného předka obou slezských větví až k nám, vlevo 1. větev (Dvorce, Koryčany, pruští baroni), vpravo nejbližší příbuzní z 2. větve. Plná zelená čára = doloženo matrikou, plná hnědá = z literatury, tečkovaná = vztah nejistý. Na každou osobu se dá kliknout – otevře se její profil se vším, co o ní víme.</p>
      <div class="chips">
        {Object.entries(STAV).map(([k, s]) => <span class={`chip ${s.cls}`}>{s.label}</span>)}
        <span class="chip rg-chip-svedek">svědek na svatbě</span>
      </div>
      <div class="rg-graf-wrap">
        <svg class="rg-graf" viewBox={`0 0 ${svgW} ${svgH}`} role="img" aria-label="Schéma napojení naší linie na šlechtický rod">
          {g.sloupce.map((s, i) => (
            <g>
              <rect x={X0 + i * CX - 8} y="6" width={W + 16} height={svgH - 12} rx="12" fill={i === 2 ? '#eaf3e7' : i % 2 ? '#f7f2ea' : '#f4f1f6'} />
              <text x={X0 + i * CX + W / 2} y="32" text-anchor="middle" class="rg-sl">{s}</text>
            </g>
          ))}
          {g.hrany.map((h) => {
            const e = edge(h);
            return e && (
              <g>
                <path d={e.d} fill="none" style={ESTYL[h.typ] ?? ESTYL.nejiste} />
                {h.popis && <text x={e.lx} y={e.ly} class="rg-hl">{h.popis}</text>}
              </g>
            );
          })}
          {g.uzly.map((u) => {
            const p = pos[u.id];
            const link = osobaHref(u.osoba) ?? profilHref(u.profil);
            const box = (
              <g class={link ? 'rg-uzel rg-link' : 'rg-uzel'}>
                <rect x={p.x} y={p.y} width={W} height={H} rx="9" style={NSTYL[u.stav] ?? NSTYL.hyp} stroke-width="1.6" />
                <text x={p.x + 12} y={p.y + 22} class="rg-n">{u.jmeno}</text>
                <text x={p.x + 12} y={p.y + 40} class="rg-r">{u.roky}</text>
                <text x={p.x + 12} y={p.y + 56} class="rg-p">{u.pozn}</text>
              </g>
            );
            return link ? <a href={link}>{box}</a> : box;
          })}
        </svg>
      </div>
      <p class="small muted rg-swipe">Na telefonu schéma posunete prstem do stran.</p>
    </section>
  )}

  {d.rodokmen && (
    <section id="rodokmen">
      <h2>Rodokmen rodu</h2>
      {d.rodokmen.uvod && <p class="muted small">{d.rodokmen.uvod}</p>}
      <div class="rt-bar">
        <form class="rt-hledat" autocomplete="off">
          <input list="rt-jmena" placeholder="Najít osobu…" aria-label="Najít osobu v rodokmenu" />
          <datalist id="rt-jmena"></datalist>
          <button type="submit">Najít</button>
        </form>
        <span class="rt-btns">
          <button type="button" data-z="1.4" aria-label="Přiblížit">+</button>
          <button type="button" data-z="0.714" aria-label="Oddálit">−</button>
          <button type="button" data-z="-2">Naše linie</button>
          <button type="button" data-z="0">Celý</button>
          <button type="button" data-z="-1">Na celou obrazovku</button>
        </span>
      </div>
      <div class="rt-stage" data-zarovnat={JSON.stringify(d.rodokmen.casti.filter((c) => !c.mimo).map((c) => c.zarovnat_k ?? null))} data-spojnice={JSON.stringify(d.rodokmen.spojnice ?? [])}>
        <div class="rt-platno">
          <svg class="rt-spoje" aria-hidden="true"></svg>
          {d.rodokmen.casti.filter((c) => !c.mimo).map((c) => (
            <div class="rt-cast">
              <div class="rt-nadpis"><strong>{c.nadpis}</strong>{c.text && <span>{c.text}</span>}</div>
              <RodStrom uzly={c.uzly} slug={slug} profily={d.profily} koren />
            </div>
          ))}
        </div>
      </div>
      <script>
        const stage = document.querySelector<HTMLElement>('.rt-stage')!;
        const platno = stage.querySelector<HTMLElement>('.rt-platno')!;
        let v = { x: 0, y: 0, s: 1 };
        const apply = (anim = false) => {
          platno.style.transition = anim ? 'transform 0.35s ease' : 'none';
          platno.style.transform = `translate(${v.x}px, ${v.y}px) scale(${v.s})`;
        };
        // poloha prvku v souřadnicích plátna (nezávisle na posunu a přiblížení)
        const vPlatne = (el: Element) => {
          const r = el.getBoundingClientRect(), p = platno.getBoundingClientRect();
          return { x: (r.left - p.left) / v.s, y: (r.top - p.top) / v.s, w: r.width / v.s, h: r.height / v.s };
        };
        const karta = (id: string) => platno.querySelector(`li[data-id="${id}"] > .ot-uzel`);

        // naše větev posazená do generace podle let + tečkované spojnice „napojení hledáme“
        const rozvrhni = () => {
          const casti = [...platno.querySelectorAll<HTMLElement>('.rt-cast')];
          const zar = JSON.parse(stage.dataset.zarovnat || '[]');
          casti.forEach((c, i) => {
            const strom = c.querySelector<HTMLElement>('.ot-koren')!;
            strom.style.marginTop = '0px';
            const cil = zar[i] && karta(zar[i]);
            const koren = c.querySelector('.ot-koren > li > .ot-uzel');
            if (cil && koren) strom.style.marginTop = Math.max(0, vPlatne(cil).y - vPlatne(koren).y) + 'px';
          });
          const svg = platno.querySelector<SVGSVGElement>('.rt-spoje')!;
          svg.setAttribute('width', String(platno.scrollWidth)); svg.setAttribute('height', String(platno.scrollHeight));
          svg.innerHTML = '';
          // spojnice vedou pod kartičkami předků (v mezeře nad lištou jejich dětí), slévají se a vstupují do cíle zleva
          const sps = JSON.parse(stage.dataset.spojnice || '[]').map((sp) => ({ sp, a: karta(sp.z), b: karta(sp.do) })).filter((x) => x.a && x.b);
          const y0 = Math.max(...sps.map((x) => { const A = vPlatne(x.a); return A.y + A.h; })) + 8;
          for (const { sp, a, b } of sps) {
            const A = vPlatne(a), B = vPlatne(b);
            const x1 = A.x + A.w / 2, y1 = A.y + A.h, xb = B.x - 28, yb = B.y + B.h / 2;
            const d = `M${x1},${y1} V${y0} H${xb - 14} Q${xb},${y0} ${xb},${y0 + 14} V${yb - 14} Q${xb},${yb} ${xb + 14},${yb} H${B.x}`;
            svg.insertAdjacentHTML('beforeend', sp.doc
              ? `<path d="${d}" fill="none" stroke="#3f7d4a" stroke-width="2.4" stroke-linecap="round"/>`
              : `<path d="${d}" fill="none" stroke="#8a8278" stroke-width="2.2" stroke-dasharray="2 6" stroke-linecap="round"/>`);
            if (sp.popis) svg.insertAdjacentHTML('beforeend', `<text x="${x1 + 8}" y="${y0 + 16}" class="rt-sp-popis" text-anchor="start">${sp.popis}</text>`);
          }
          if (sps.some((x) => !x.sp.doc)) {
            const B = vPlatne(sps.find((x) => !x.sp.doc)!.b);
            svg.insertAdjacentHTML('beforeend', `<text x="${B.x - 40}" y="${y0 - 6}" class="rt-sp-popis" text-anchor="end">napojení hledáme ?</text>`);
          }
        };
        const celek = (anim = true) => {
          const W = platno.scrollWidth, H = platno.scrollHeight, r = stage.getBoundingClientRect();
          v.s = Math.min(r.width / W, r.height / H) * 0.96;
          v.x = (r.width - W * v.s) / 2; v.y = (r.height - H * v.s) / 2;
          apply(anim);
        };
        const naKartu = (el: Element, s = 0.9) => {
          const P = vPlatne(el), r = stage.getBoundingClientRect();
          v.s = s; v.x = r.width / 2 - (P.x + P.w / 2) * s; v.y = r.height / 3 - (P.y + P.h / 2) * s;
          apply(true);
        };
        // „Naše linie“: zvýraznit přímou linii a ukázat ji od Maximiliána dolů
        const naseLinie = () => {
          platno.querySelectorAll('.ot-cesta').forEach((x) => x.classList.remove('ot-cesta'));
          const nase = [...platno.querySelectorAll<HTMLElement>('.ot-uzel.ot-nase')];
          nase.forEach((x) => x.classList.add('ot-cesta'));
          const cil = platno.querySelector('li[data-id="maxmilian"] > .ot-uzel') ?? nase[0];
          if (cil) naKartu(cil, 0.75);
        };
        const start = () => {
          v = { x: 0, y: 0, s: 1 }; apply();
          rozvrhni();
          // úvodní pohled: kmen a rozdělení na obě větve (1. větev vlevo, naše 2. větev vpravo), čitelně
          const koren = platno.querySelector('.rt-cast .ot-uzel');
          const L = karta('fw1'), P = karta('ch');
          const r = stage.getBoundingClientRect();
          if (koren && L && P) {
            const K = vPlatne(koren), A = vPlatne(L), B = vPlatne(P);
            const sirka = B.x + B.w - A.x + 80;
            v.s = Math.max(0.35, Math.min(0.85, r.width / sirka));
            v.x = r.width / 2 - ((A.x + B.x + B.w) / 2) * v.s; v.y = 12 - (K.y - 60) * v.s;
            apply();
          } else celek(false);
        };
        (document.fonts?.ready ?? Promise.resolve()).then(start);

        const zoomAt = (f: number, cx?: number, cy?: number) => {
          const r = stage.getBoundingClientRect();
          const px = (cx ?? r.left + r.width / 2) - r.left, py = (cy ?? r.top + r.height / 2) - r.top;
          const s = Math.min(2.5, Math.max(0.08, v.s * f)), k = s / v.s;
          v = { x: px - (px - v.x) * k, y: py - (py - v.y) * k, s };
          apply();
        };
        stage.addEventListener('wheel', (e) => {
          e.preventDefault();
          let d = e.deltaY;
          if (e.deltaMode === 1) d *= 33; else if (e.deltaMode === 2) d *= 300;
          d = Math.max(-120, Math.min(120, d));
          zoomAt(Math.exp(-d * (e.ctrlKey ? 0.012 : 0.0022)), e.clientX, e.clientY);
        }, { passive: false });

        const pts = new Map<number, { x: number; y: number }>();
        let moved = 0, pinch = 0;
        stage.addEventListener('pointerdown', (e) => { pts.set(e.pointerId, { x: e.clientX, y: e.clientY }); moved = 0; stage.classList.add('tahne'); });
        stage.addEventListener('pointermove', (e) => {
          const prev = pts.get(e.pointerId);
          if (!prev) return;
          pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
          if (pts.size === 2) {
            const [a, b] = [...pts.values()];
            const d = Math.hypot(a.x - b.x, a.y - b.y);
            if (pinch) zoomAt(d / pinch, (a.x + b.x) / 2, (a.y + b.y) / 2);
            pinch = d; moved += 10;
            return;
          }
          const dx = e.clientX - prev.x, dy = e.clientY - prev.y;
          moved += Math.abs(dx) + Math.abs(dy);
          if (moved > 4) { stage.setPointerCapture(e.pointerId); v.x += dx; v.y += dy; apply(); }
        });
        const up = (e: PointerEvent) => { pts.delete(e.pointerId); if (pts.size < 2) pinch = 0; if (!pts.size) stage.classList.remove('tahne'); };
        stage.addEventListener('pointerup', up);
        stage.addEventListener('pointercancel', up);
        stage.addEventListener('click', (e) => {
          if (moved > 4) { e.preventDefault(); e.stopPropagation(); return; }
          if ((e.target as Element).closest('a')) return;
          // klepnutí na kartičku: zvýraznit cestu k nejstaršímu předkovi
          const k = (e.target as Element).closest('.ot-uzel');
          const bylo = k?.classList.contains('ot-cesta');
          platno.querySelectorAll('.ot-cesta').forEach((x) => x.classList.remove('ot-cesta'));
          if (!k || bylo) return;
          for (let li = k.closest('li'); li; li = li.parentElement?.closest('li') ?? null) li.querySelector(':scope > .ot-uzel')?.classList.add('ot-cesta');
        }, true);

        document.querySelectorAll<HTMLButtonElement>('.rt-btns button').forEach((b) =>
          b.addEventListener('click', () => {
            const z = Number(b.dataset.z);
            if (z > 0) { zoomAt(z); }
            else if (z === 0) celek();
            else if (z === -2) naseLinie();
            else if (document.fullscreenElement) document.exitFullscreen();
            else (stage.requestFullscreen?.() ?? Promise.resolve()).catch(() => {});
          })
        );
        document.addEventListener('fullscreenchange', () => setTimeout(() => celek(false), 50));

        // hledání osoby: přiblížit a zvýraznit
        const norm = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
        const karty = [...platno.querySelectorAll<HTMLElement>('.ot-jmeno, .ot-jm')];
        const dl = document.getElementById('rt-jmena')!;
        [...new Set(karty.map((k) => k.textContent!.trim()))].sort((a, b) => a.localeCompare(b, 'cs')).forEach((n) => { const o = document.createElement('option'); o.value = n; dl.appendChild(o); });
        document.querySelector('.rt-hledat')!.addEventListener('submit', (e) => {
          e.preventDefault();
          const q = norm((e.currentTarget as HTMLFormElement).querySelector('input')!.value.trim());
          platno.querySelectorAll('.ot-hit').forEach((x) => x.classList.remove('ot-hit'));
          if (!q) return;
          const hit = karty.filter((k) => norm(k.textContent || '').includes(q)).map((k) => k.closest('.ot-uzel')!);
          if (!hit.length) return;
          hit.forEach((h) => h.classList.add('ot-hit'));
          naKartu(hit[0]);
        });
      </script>
      {d.rodokmen.casti.some((c) => c.mimo) && (
        <div class="rt-mimo">
          <h3>Gillerové mimo hlavní strom</h3>
          <p class="muted small">Rodiny stejného jména, které zatím nedokážeme do stromu napojit – měšťané a řemeslníci ve Dvorcích (vedle 1. větve) a jednotlivci z pramenů.</p>
          {d.rodokmen.casti.filter((c) => c.mimo).map((c) => (
            <div class="rt-mimo-cast">
              <h4>{c.nadpis}</h4>
              {c.text && <p class="small muted">{c.text}</p>}
              <div class="rt-mimo-strom"><RodStrom uzly={c.uzly} slug={slug} profily={d.profily} koren /></div>
            </div>
          ))}
        </div>
      )}
    </section>
  )}

  {d.osa?.length > 0 && (
    <section id="osa">
      <h2>Časová osa rodu</h2>
      <ol class="rg-osa">
        {d.osa.map((o) => (
          <li class={o.osoba ? 'rg-nase' : ''}>
            <span class="rg-rok">{o.rok}</span>
            <div>
              <p>{o.text} {o.osoba && osobaHref(o.osoba) && <a href={osobaHref(o.osoba)}>→ osoba</a>}</p>
              {o.zdroj && <p class="small muted">Zdroj: {o.zdroj}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  {d.vetve?.length > 0 && (
    <section id="vetve">
      <h2>Větve rodu</h2>
      <div class="grid2">
        {d.vetve.map((v) => (
          <div class="card rg-vetev" style={`--c:${v.barva ?? '#8a5a2b'}`}>
            <h3>{v.nazev}</h3>
            <p class="small muted">{v.obdobi}</p>
            <p class="small">{v.text}</p>
            {v.vazba && <p class="small rg-vazba"><strong>Vazba k nám:</strong> {v.vazba}</p>}
            {profilHref(v.profil) && <p class="small"><a href={profilHref(v.profil)}>Podrobnosti →</a></p>}
          </div>
        ))}
      </div>
    </section>
  )}

  {d.osoby?.length > 0 && (
    <section id="osoby">
      <h2>Další Gillernové v pramenech</h2>
      <p class="muted small">Lidé s naším příjmením, na které jsme narazili mimo přímou linii. U každého je, odkud o něm víme a jak jisté to je.</p>
      <div class="grid2">
        {d.osoby.map((o) => (
          <div class="card">
            <h3>{osobaHref(o.osoba) || profilHref(o.profil) ? <a href={osobaHref(o.osoba) ?? profilHref(o.profil)}>{o.jmeno}</a> : o.jmeno}</h3>
            <p class="small"><span class={`chip ${STAV[o.stav]?.cls ?? 'st-unk'}`}>{STAV[o.stav]?.label ?? o.stav}</span> <span class="muted">{o.roky}</span></p>
            <p class="small">{o.text}</p>
            <p class="small muted">Zdroj: {o.odkaz ? <a href={o.odkaz} rel="noopener">{o.zdroj}</a> : o.zdroj}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {d.otazky?.length > 0 && (
    <section id="otazky">
      <h2>Co ještě hledáme</h2>
      <ul class="facts">{d.otazky.map((q) => <li>{q}</li>)}</ul>
    </section>
  )}

  {d.zdroje?.length > 0 && (
    <section id="zdroje">
      <h2>Zdroje</h2>
      <ul class="facts small">{d.zdroje.map((z) => <li>{z.odkaz ? <a href={z.odkaz} rel="noopener">{z.nazev}</a> : z.nazev}</li>)}</ul>
    </section>
  )}

  <div class="next-step">
    <p><strong>Přímá linie</strong> – podrobně a s výřezy z matrik – je v rodu Gillernů a v příbězích.</p>
    <p><a class="btn" href="/rody/">Rody →</a> <a class="btn" href="/pribehy/">Příběhy →</a> <a class="btn" href="/vejir/">Vějíř předků →</a></p>
  </div>
</Base>

